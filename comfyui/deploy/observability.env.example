# Keep the real values only in /etc/ad-creator/observability.env (mode 0640).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

AD_CREATOR_GATEWAY_DB=/var/lib/ad-creator-gateway/gateway.sqlite3
AD_CREATOR_OPENAI_AUDIT_DIR=/opt/comfyui/ComfyUI/output/ad_creator/audit
AD_CREATOR_LANGFUSE_STATE_DB=/var/lib/ad-creator-observability/state.sqlite3
AD_CREATOR_OPENAI_PRICING_FILE=/opt/ad-creator/comfyui/observability/openai_image_pricing.json
AD_CREATOR_OBSERVABILITY_ENVIRONMENT=production
AD_CREATOR_OBSERVABILITY_RELEASE=
AD_CREATOR_LANGFUSE_TIMEOUT_SECONDS=15
AD_CREATOR_LANGFUSE_POLL_SECONDS=1
# An uncertain OTLP result is reconciled before retrying to prevent duplicates.
AD_CREATOR_LANGFUSE_RECONCILE_AFTER_SECONDS=600
