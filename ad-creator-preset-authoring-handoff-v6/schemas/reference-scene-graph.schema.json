{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ad-creator.local/schemas/reference-scene-graph.schema.json",
  "title": "Ad Creator Reference Scene Graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_metadata",
    "asset",
    "scene_mode",
    "objects",
    "relations",
    "support_surfaces",
    "protected_regions",
    "insertion_zones",
    "composition",
    "depth",
    "lighting",
    "color",
    "facets",
    "taxonomy",
    "runtime_policy",
    "quality_flags"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "analysis_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version", "analyzed_at", "confidence"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "prompt_version": { "const": "reference_scene_graph_v2" },
        "analyzed_at": { "type": "string", "format": "date-time" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "relative_path",
        "file_sha256",
        "pixel_sha256",
        "width_px",
        "height_px",
        "format",
        "source_folder_tags",
        "dhash",
        "duplicate_of"
      ],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^ref_[a-f0-9]{16}$" },
        "relative_path": { "$ref": "#/$defs/nonEmptyString" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "pixel_sha256": { "$ref": "#/$defs/sha256" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "format": { "$ref": "#/$defs/nonEmptyString" },
        "source_folder_tags": { "$ref": "#/$defs/stringArray" },
        "dhash": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "duplicate_of": { "type": ["string", "null"] }
      }
    },
    "scene_mode": { "enum": ["solo", "pair", "set"] },
    "observed_major_subject_count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "object_inventory_complete": { "type": "boolean" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/sceneObject" }
    },
    "relations": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/relation" }
    },
    "support_surfaces": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/supportSurface" }
    },
    "protected_regions": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/protectedRegion" }
    },
    "insertion_zones": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/insertionZone" }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_type",
        "camera_height",
        "camera_pitch",
        "lens_character",
        "subject_position",
        "negative_space",
        "asymmetry_source",
        "crop_character"
      ],
      "properties": {
        "shot_type": { "enum": ["handheld", "tabletop", "overhead", "closeup", "group", "overflow", "other"] },
        "camera_height": { "enum": ["low", "product_level", "slightly_above", "high", "overhead"] },
        "camera_pitch": { "$ref": "#/$defs/nonEmptyString" },
        "lens_character": { "enum": ["phone_wide", "phone_normal", "phone_mild_tele", "unknown"] },
        "subject_position": { "$ref": "#/$defs/nonEmptyString" },
        "negative_space": { "$ref": "#/$defs/nonEmptyString" },
        "asymmetry_source": { "$ref": "#/$defs/nonEmptyString" },
        "crop_character": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane_count",
        "foreground",
        "product_plane",
        "midground",
        "background",
        "perspective_cues",
        "far_plane_softness",
        "atmospheric_separation"
      ],
      "properties": {
        "plane_count": { "type": "integer", "minimum": 1, "maximum": 5 },
        "foreground": { "$ref": "#/$defs/nonEmptyString" },
        "product_plane": { "$ref": "#/$defs/nonEmptyString" },
        "midground": { "$ref": "#/$defs/nonEmptyString" },
        "background": { "$ref": "#/$defs/nonEmptyString" },
        "perspective_cues": { "$ref": "#/$defs/nonEmptyStringArray" },
        "far_plane_softness": { "enum": ["none", "subtle", "moderate", "strong"] },
        "atmospheric_separation": { "enum": ["none", "trace", "mild", "strong"] }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "direction",
        "source_size",
        "hardness",
        "contrast",
        "shadow",
        "highlight",
        "transmitted_light",
        "white_balance"
      ],
      "properties": {
        "source_type": { "enum": ["direct_sun", "soft_window", "overcast", "artificial_warm", "mixed", "unknown"] },
        "direction": { "$ref": "#/$defs/nonEmptyString" },
        "source_size": { "enum": ["small", "medium", "large", "unknown"] },
        "hardness": { "$ref": "#/$defs/confidence" },
        "contrast": { "$ref": "#/$defs/confidence" },
        "shadow": { "$ref": "#/$defs/nonEmptyString" },
        "highlight": { "$ref": "#/$defs/nonEmptyString" },
        "transmitted_light": { "$ref": "#/$defs/nonEmptyString" },
        "white_balance": { "enum": ["cool", "neutral", "slightly_warm", "warm", "mixed"] }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "saturation",
        "contrast",
        "black_point",
        "palette_hex",
        "mean_luminance",
        "luminance_stddev",
        "mean_saturation",
        "edge_energy"
      ],
      "properties": {
        "exposure": { "enum": ["dark", "low", "balanced", "bright", "high_key"] },
        "saturation": { "enum": ["muted", "restrained", "natural", "vivid"] },
        "contrast": { "enum": ["low", "soft", "medium", "strong"] },
        "black_point": { "enum": ["lifted", "natural", "deep"] },
        "palette_hex": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^#[A-F0-9]{6}$" }
        },
        "mean_luminance": { "$ref": "#/$defs/confidence" },
        "luminance_stddev": { "$ref": "#/$defs/confidence" },
        "mean_saturation": { "$ref": "#/$defs/confidence" },
        "edge_energy": { "$ref": "#/$defs/confidence" }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mood_tags", "environment_tags", "material_tags", "shot_tags"],
      "properties": {
        "mood_tags": { "$ref": "#/$defs/nonEmptyStringArray" },
        "environment_tags": { "$ref": "#/$defs/nonEmptyStringArray" },
        "material_tags": { "$ref": "#/$defs/nonEmptyStringArray" },
        "shot_tags": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_family",
        "lighting_family",
        "camera_angle",
        "capture_style",
        "scene_complexity",
        "dominant_surface",
        "wood_prominence",
        "accent_color_prominence",
        "frontend_mood",
        "frontend_angle",
        "confidence"
      ],
      "properties": {
        "environment_family": { "enum": ["white_neutral", "warm_wood", "point_color", "modern_mineral", "vintage_warm", "dark_moody", "mixed_other"] },
        "lighting_family": { "enum": ["direct_sun", "soft_window", "overcast", "warm_ambient", "mixed"] },
        "camera_angle": { "enum": ["eye_level", "slightly_above", "high_angle", "overhead"] },
        "capture_style": { "enum": ["held_product", "tabletop", "closeup", "group", "overflow"] },
        "scene_complexity": { "enum": ["solo", "pair", "set"] },
        "dominant_surface": { "$ref": "#/$defs/nonEmptyString" },
        "wood_prominence": { "$ref": "#/$defs/confidence" },
        "accent_color_prominence": { "$ref": "#/$defs/confidence" },
        "frontend_mood": { "enum": ["white", "wood", "point_color"] },
        "frontend_angle": { "enum": ["eye_level", "slightly_above", "high_angle", "overhead"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_pixels_allowed",
        "container_pixels_allowed",
        "copy_exclusions",
        "maximum_exact_products",
        "maximum_generic_companions",
        "maximum_major_subjects",
        "maximum_props"
      ],
      "properties": {
        "scene_pixels_allowed": { "const": false },
        "container_pixels_allowed": { "const": true },
        "copy_exclusions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "maximum_exact_products": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maximum_generic_companions": { "const": 1 },
        "maximum_major_subjects": { "const": 3 },
        "maximum_props": { "const": 2 }
      }
    },
    "quality_flags": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom", "confidence"],
      "properties": {
        "left": { "$ref": "#/$defs/coordinate" },
        "top": { "$ref": "#/$defs/coordinate" },
        "right": { "$ref": "#/$defs/coordinate" },
        "bottom": { "$ref": "#/$defs/coordinate" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "straw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "bbox", "centerline", "emergence_point", "angle_degrees"],
      "properties": {
        "present": { "type": "boolean" },
        "bbox": { "anyOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
        "centerline": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" }],
              "minItems": 2,
              "maxItems": 2
            },
            { "type": "null" }
          ]
        },
        "emergence_point": { "anyOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
        "angle_degrees": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "material", "silhouette", "components"],
      "properties": {
        "class": { "$ref": "#/$defs/nonEmptyString" },
        "material": { "$ref": "#/$defs/nonEmptyString" },
        "silhouette": { "$ref": "#/$defs/nonEmptyString" },
        "components": { "$ref": "#/$defs/stringArray" }
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "kind",
        "role",
        "description",
        "body_bbox",
        "full_bbox",
        "straw",
        "container",
        "interaction",
        "support_surface_id",
        "depth_order",
        "occlusion_fraction",
        "replaceable",
        "allowed_kinds",
        "visible_text",
        "brand_or_watermark_state",
        "crop_safe"
      ],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,48}$" },
        "kind": { "enum": ["beverage", "dessert", "prop", "support"] },
        "role": { "enum": ["primary", "secondary", "accent", "support"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "body_bbox": { "$ref": "#/$defs/bbox" },
        "full_bbox": { "$ref": "#/$defs/bbox" },
        "straw": { "$ref": "#/$defs/straw" },
        "container": { "anyOf": [{ "$ref": "#/$defs/container" }, { "type": "null" }] },
        "interaction": { "enum": ["resting", "held", "touching", "pouring", "overlapping", "background", "other"] },
        "support_surface_id": { "type": ["string", "null"] },
        "depth_order": { "type": "integer", "minimum": 0, "maximum": 20 },
        "occlusion_fraction": { "$ref": "#/$defs/confidence" },
        "replaceable": { "type": "boolean" },
        "allowed_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["beverage", "dessert", "prop"] }
        },
        "visible_text": { "$ref": "#/$defs/stringArray" },
        "brand_or_watermark_state": { "enum": ["present", "absent", "uncertain"] },
        "crop_safe": { "type": "boolean" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_slot_id", "predicate", "to_slot_id", "confidence"],
      "properties": {
        "from_slot_id": { "$ref": "#/$defs/nonEmptyString" },
        "predicate": { "enum": ["left_of", "right_of", "in_front_of", "behind", "overlaps", "touches", "paired_with"] },
        "to_slot_id": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "supportSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "kind", "bbox", "plane_description", "supports_objects", "perspective_scale"],
      "properties": {
        "surface_id": { "type": "string", "pattern": "^surface_[a-z0-9_]+$" },
        "kind": { "enum": ["table", "counter", "tray", "plate", "saucer", "shelf", "ground", "held_carrier", "other"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "plane_description": { "$ref": "#/$defs/nonEmptyString" },
        "supports_objects": { "type": "boolean" },
        "perspective_scale": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "protectedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "kind", "bbox", "reason"],
      "properties": {
        "region_id": { "type": "string", "pattern": "^region_[a-z0-9_]+$" },
        "kind": { "enum": ["hand", "visible_text", "watermark", "occupied", "shadow", "negative_space"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "insertionZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "bbox", "support_surface_id", "allowed_kinds", "scale_range", "confidence", "reason"],
      "properties": {
        "zone_id": { "type": "string", "pattern": "^zone_[a-z0-9_]+$" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "support_surface_id": { "$ref": "#/$defs/nonEmptyString" },
        "allowed_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["beverage", "dessert"] }
        },
        "scale_range": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
