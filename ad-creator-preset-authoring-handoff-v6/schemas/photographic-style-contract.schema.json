{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ad-creator.local/schemas/photographic-style-contract.schema.json",
  "title": "Ad Creator Photographic Style Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "preset_id",
    "creative_direction",
    "reference_binding",
    "camera_geometry",
    "composition_geometry",
    "composition_variation",
    "lighting_geometry",
    "tone_signature",
    "finish_signature",
    "qa_contract"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "preset_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "desired_response", "art_direction", "restraint", "forbidden_impression"],
      "properties": {
        "audience": { "$ref": "#/$defs/nonEmptyString" },
        "desired_response": { "$ref": "#/$defs/nonEmptyString" },
        "art_direction": { "$ref": "#/$defs/nonEmptyString" },
        "restraint": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden_impression": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "reference_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "pixel_sha256", "relative_path", "width_px", "height_px", "runtime_role", "provider_submission"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/nonEmptyString" },
        "pixel_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "relative_path": { "$ref": "#/$defs/nonEmptyString" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "runtime_role": { "$ref": "#/$defs/nonEmptyString" },
        "provider_submission": { "const": "never" }
      }
    },
    "camera_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "focal_length_equivalent_mm", "working_distance_cm", "camera_height_cm", "pitch_degrees", "yaw_degrees", "roll_degrees", "distortion", "depth_of_field"],
      "properties": {
        "projection": { "$ref": "#/$defs/nonEmptyString" },
        "focal_length_equivalent_mm": { "$ref": "#/$defs/positiveRange" },
        "working_distance_cm": { "$ref": "#/$defs/positiveRange" },
        "camera_height_cm": { "$ref": "#/$defs/positiveRange" },
        "pitch_degrees": { "$ref": "#/$defs/numberRange" },
        "yaw_degrees": { "$ref": "#/$defs/numberRange" },
        "roll_degrees": { "$ref": "#/$defs/numberRange" },
        "distortion": { "$ref": "#/$defs/nonEmptyString" },
        "depth_of_field": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "composition_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_subject_bbox", "bbox_semantics", "primary_subject_area_ratio", "negative_space", "support_plane", "frame_rhythm", "crop_policy", "forbidden"],
      "properties": {
        "primary_subject_bbox": { "$ref": "#/$defs/bbox" },
        "bbox_semantics": { "$ref": "#/$defs/nonEmptyString" },
        "primary_subject_area_ratio": { "$ref": "#/$defs/ratioRange" },
        "negative_space": { "$ref": "#/$defs/nonEmptyString" },
        "support_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "occupancy_ratio", "dominant_edge_angles_degrees", "perspective"],
          "properties": {
            "kind": { "$ref": "#/$defs/nonEmptyString" },
            "occupancy_ratio": { "$ref": "#/$defs/ratioRange" },
            "dominant_edge_angles_degrees": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": -180, "maximum": 180 } },
            "perspective": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "frame_rhythm": { "$ref": "#/$defs/nonEmptyString" },
        "crop_policy": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "composition_variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "invariants", "allowed_variations", "repeat_guard", "scene_similarity_limit", "reference_scene_copy_forbidden"],
      "properties": {
        "selection": { "$ref": "#/$defs/nonEmptyString" },
        "invariants": { "$ref": "#/$defs/nonEmptyStringArray" },
        "allowed_variations": { "$ref": "#/$defs/nonEmptyStringArray" },
        "repeat_guard": { "$ref": "#/$defs/nonEmptyString" },
        "scene_similarity_limit": { "$ref": "#/$defs/ratio" },
        "reference_scene_copy_forbidden": { "const": true }
      }
    },
    "lighting_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_topology", "azimuth_degrees", "elevation_degrees", "angular_size_degrees", "key_to_fill_ratio", "lit_area_ratio", "shadow_area_ratio", "shadow_vector_degrees", "penumbra_ratio", "highlight_behavior", "optical_effects", "forbidden"],
      "properties": {
        "source_topology": { "$ref": "#/$defs/nonEmptyString" },
        "azimuth_degrees": { "$ref": "#/$defs/numberRange" },
        "elevation_degrees": { "$ref": "#/$defs/numberRange" },
        "angular_size_degrees": { "$ref": "#/$defs/positiveRange" },
        "key_to_fill_ratio": { "$ref": "#/$defs/positiveRange" },
        "lit_area_ratio": { "$ref": "#/$defs/ratioRange" },
        "shadow_area_ratio": { "$ref": "#/$defs/ratioRange" },
        "shadow_vector_degrees": { "$ref": "#/$defs/numberRange" },
        "penumbra_ratio": { "$ref": "#/$defs/ratioRange" },
        "highlight_behavior": { "$ref": "#/$defs/nonEmptyString" },
        "optical_effects": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "tone_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_color_space", "white_balance_kelvin", "luma_percentiles", "black_point", "white_point", "contrast_curve", "saturation", "shadow_color", "highlight_color", "palette_hex", "material_separation", "local_contrast", "forbidden"],
      "properties": {
        "working_color_space": { "$ref": "#/$defs/nonEmptyString" },
        "white_balance_kelvin": { "$ref": "#/$defs/positiveRange" },
        "luma_percentiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p05", "p25", "p50", "p75", "p95"],
          "properties": {
            "p05": { "$ref": "#/$defs/ratioRange" },
            "p25": { "$ref": "#/$defs/ratioRange" },
            "p50": { "$ref": "#/$defs/ratioRange" },
            "p75": { "$ref": "#/$defs/ratioRange" },
            "p95": { "$ref": "#/$defs/ratioRange" }
          }
        },
        "black_point": { "$ref": "#/$defs/nonEmptyString" },
        "white_point": { "$ref": "#/$defs/nonEmptyString" },
        "contrast_curve": { "$ref": "#/$defs/nonEmptyString" },
        "saturation": { "$ref": "#/$defs/nonEmptyString" },
        "shadow_color": { "$ref": "#/$defs/nonEmptyString" },
        "highlight_color": { "$ref": "#/$defs/nonEmptyString" },
        "palette_hex": { "type": "array", "minItems": 3, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "material_separation": { "$ref": "#/$defs/nonEmptyString" },
        "local_contrast": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "finish_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acuity", "microcontrast", "grain", "depth_rendering", "retouching", "forbidden"],
      "properties": {
        "acuity": { "$ref": "#/$defs/nonEmptyString" },
        "microcontrast": { "$ref": "#/$defs/nonEmptyString" },
        "grain": { "$ref": "#/$defs/nonEmptyString" },
        "depth_rendering": { "$ref": "#/$defs/nonEmptyString" },
        "retouching": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "qa_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_fail", "weights"],
      "properties": {
        "hard_fail": { "$ref": "#/$defs/nonEmptyStringArray" },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camera_geometry", "composition_rhythm", "color_and_tone", "lighting_space", "product_identity", "brand_integrity"],
          "properties": {
            "camera_geometry": { "$ref": "#/$defs/ratio" },
            "composition_rhythm": { "$ref": "#/$defs/ratio" },
            "color_and_tone": { "$ref": "#/$defs/ratio" },
            "lighting_space": { "$ref": "#/$defs/ratio" },
            "product_identity": { "$ref": "#/$defs/ratio" },
            "brand_integrity": { "$ref": "#/$defs/ratio" }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "numberRange": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "positiveRange": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 },
    "ratioRange": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/ratio" }, { "$ref": "#/$defs/ratio" }], "minItems": 2, "maxItems": 2 },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "$ref": "#/$defs/ratio" },
        "top": { "$ref": "#/$defs/ratio" },
        "right": { "$ref": "#/$defs/ratio" },
        "bottom": { "$ref": "#/$defs/ratio" }
      }
    }
  }
}
