{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ad-creator.local/schemas/mood-package.schema.json",
  "title": "Ad Creator Mood Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mood_package_id",
    "display_name",
    "preset_path",
    "runtime_profile_path",
    "scene_recipe_path",
    "lighting_sheet_path",
    "grade_profile_path",
    "runtime_reference_policy",
    "compatibility"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mood_package_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "preset_path": { "type": "string", "minLength": 1 },
    "runtime_profile_path": { "type": "string", "minLength": 1 },
    "scene_recipe_path": { "type": "string", "minLength": 1 },
    "lighting_sheet_path": { "type": "string", "minLength": 1 },
    "grade_profile_path": { "type": "string", "minLength": 1 },
    "photographic_style_contract_path": { "type": "string", "minLength": 1 },
    "product_integration_contract_path": { "type": "string", "minLength": 1 },
    "reference_control_board_path": { "type": "string", "minLength": 1 },
    "reference_control_board_manifest_path": { "type": "string", "minLength": 1 },
    "container_design_path": { "type": "string", "minLength": 1 },
    "runtime_reference_policy": { "const": "offline_contract_only" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_modes", "materials"],
      "properties": {
        "composition_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["glass", "plastic", "paper", "ceramic"] }
        }
      }
    }
  }
}
