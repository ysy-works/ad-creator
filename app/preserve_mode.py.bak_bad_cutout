import os
import sys

import numpy as np
from PIL import Image, ImageFilter, ImageDraw

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app import preprocessing
from app.prompt_builder import build_background_only_prompt
from app.product_bbox_openai import detect_product_bbox


_SESSION = None


def _session():
    global _SESSION
    if _SESSION is None:
        from rembg import new_session
        _SESSION = new_session()
    return _SESSION


def _alpha_bbox(rgba):
    a = np.array(rgba.split()[-1])
    ys, xs = np.where(a > 10)
    if len(xs) == 0:
        return None
    return int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1


def _largest_component_alpha(rgba: Image.Image, alpha_threshold: int = 120) -> Image.Image:
    arr = np.array(rgba)
    mask = arr[..., 3] >= alpha_threshold
    h, w = mask.shape

    visited = np.zeros_like(mask, dtype=bool)
    best = None

    for y in range(h):
        for x in range(w):
            if not mask[y, x] or visited[y, x]:
                continue

            stack = [(x, y)]
            visited[y, x] = True
            xs = []
            ys = []

            while stack:
                cx, cy = stack.pop()
                xs.append(cx)
                ys.append(cy)

                for nx, ny in ((cx + 1, cy), (cx - 1, cy), (cx, cy + 1), (cx, cy - 1)):
                    if 0 <= nx < w and 0 <= ny < h and mask[ny, nx] and not visited[ny, nx]:
                        visited[ny, nx] = True
                        stack.append((nx, ny))

            if best is None or len(xs) > best[0]:
                best = (len(xs), xs, ys)

    clean = np.zeros((h, w), dtype=np.uint8)

    if best is not None:
        _, xs, ys = best
        clean[ys, xs] = 255
    else:
        clean[mask] = 255

    alpha = Image.fromarray(clean, "L").filter(ImageFilter.GaussianBlur(1))
    arr[..., 3] = np.array(alpha)
    return Image.fromarray(arr, "RGBA")


def cutout_with_openai_bbox(image: Image.Image, alpha_threshold: int = 120) -> Image.Image:
    """
    Use OpenAI Vision to find product bbox.
    Run rembg only inside that bbox.
    Paste the cropped product back into the original canvas as RGBA.
    """
    from rembg import remove

    image = image.convert("RGB")
    W, H = image.size

    bbox = detect_product_bbox(image)
    if bbox is None:
        print("[bbox] fallback: full-image rembg", flush=True)
        crop_box = (0, 0, W, H)
    else:
        crop_box = bbox

    x1, y1, x2, y2 = crop_box
    crop = image.crop(crop_box)

    rgba_crop = remove(crop, session=_session()).convert("RGBA")
    rgba_crop = _largest_component_alpha(rgba_crop, alpha_threshold=alpha_threshold)

    canvas = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    canvas.alpha_composite(rgba_crop, (x1, y1))

    return canvas


def _contact_shadow(size, blur, opacity=90):
    w, h = size
    ell_w, ell_h = int(w * 0.95), max(10, int(h * 0.08))
    margin = blur * 3 + 4
    cw, ch = ell_w + margin * 2, ell_h + margin * 2
    s = Image.new("RGBA", (cw, ch), (0, 0, 0, 0))
    ImageDraw.Draw(s).ellipse(
        [margin, margin, margin + ell_w, margin + ell_h],
        fill=(0, 0, 0, opacity),
    )
    return s.filter(ImageFilter.GaussianBlur(blur))


def _resize_product(product, composition, scene_size):
    tW, tH = scene_size

    if composition == "closeup":
        frac = 0.72
    elif composition == "medium":
        frac = 0.42
    elif composition == "aerial":
        frac = 0.48
    elif composition == "handheld":
        frac = 0.52
    else:
        frac = 0.45

    target_h = int(tH * frac)
    target_w = int(product.width * (target_h / product.height))

    if target_w > tW * 0.86:
        target_w = int(tW * 0.86)
        target_h = int(product.height * (target_w / product.width))

    return product.resize((max(1, target_w), max(1, target_h)), Image.LANCZOS)


def run_preserve(
    pipe,
    image,
    image_path,
    full_prompt,
    composition,
    background_style,
    strength,
    seed,
    guidance_scale,
    num_inference_steps,
    width,
    height,
):
    import torch

    if seed is None:
        seed = int(torch.randint(0, 2**31 - 1, (1,)).item())

    gen = torch.Generator(device="cpu").manual_seed(seed)
    w16, h16 = preprocessing.to_multiple_of_16(width, height)

    # 1. Product cutout using OpenAI bbox + cropped rembg.
    product_rgba = cutout_with_openai_bbox(image)
    pbox = _alpha_bbox(product_rgba)

    if pbox is None:
        print("[preserve] cutout failed; fallback to full Kontext generation", flush=True)
        with torch.inference_mode():
            out = pipe(
                image=image,
                prompt=full_prompt,
                width=w16,
                height=h16,
                num_inference_steps=num_inference_steps,
                guidance_scale=guidance_scale,
                generator=gen,
            ).images[0]
        return out, seed

    product = product_rgba.crop(pbox)

    # 2. Generate empty background scene.
    bg_prompt = build_background_only_prompt(background_style, composition)
    with torch.inference_mode():
        scene = pipe(
            image=image,
            prompt=bg_prompt,
            width=w16,
            height=h16,
            num_inference_steps=num_inference_steps,
            guidance_scale=guidance_scale,
            generator=gen,
        ).images[0].convert("RGBA")

    # 3. Place original product pixels.
    tW, tH = scene.size
    product_scaled = _resize_product(product, composition, scene.size)
    target_w, target_h = product_scaled.size

    cx = tW // 2
    baseline = int(tH * (0.88 if composition == "closeup" else 0.82))

    paste_x = cx - target_w // 2
    paste_y = baseline - target_h

    # aerial should sit more central.
    if composition == "aerial":
        paste_y = tH // 2 - target_h // 2

    result = scene.copy()

    if composition != "aerial":
        shadow = _contact_shadow((target_w, target_h), blur=max(5, target_w // 15))
        sx = cx - shadow.width // 2
        sy = baseline - shadow.height // 2
        result.alpha_composite(shadow, (sx, sy))

    result.alpha_composite(product_scaled, (paste_x, paste_y))

    # Product-lock: no harmonize. Keep original product pixels unchanged.
    return result.convert("RGB"), seed
