"""Build concise prompts for product-preserving scene regeneration."""
import os
import json
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app import config
from presets.compositions import COMPOSITION_PROMPTS
from presets.backgrounds import BACKGROUND_PROMPTS
from presets.quality_rules import PRESERVATION_RULES, QUALITY_RULES, STRENGTH_RULES
from presets.category_prompts import CATEGORY_PROMPTS


def _short_style_sheet(background_style: str, composition: str) -> str:
    path = os.path.join(config.BASE_DIR, "presets", "style_sheets.json")
    if not os.path.exists(path):
        return ""

    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)

        sheet = data.get(background_style, {}).get(composition)
        if not sheet:
            return ""

        parts = [
            sheet.get("one_sentence_direction", ""),
            sheet.get("composition_force_prompt", ""),
            sheet.get("instagram_style_prompt", ""),
        ]
        return " ".join(x for x in parts if x)[:900]
    except Exception:
        return ""


def build_prompt(composition: str, background_style: str, strength: str = "medium") -> str:
    if composition not in config.COMPOSITIONS:
        raise config.PipelineError(config.ErrorCode.UNSUPPORTED_COMPOSITION, composition)
    if background_style not in config.BACKGROUND_STYLES:
        raise config.PipelineError(config.ErrorCode.UNSUPPORTED_BACKGROUND_STYLE, background_style)
    if strength not in config.STRENGTHS:
        raise config.PipelineError(config.ErrorCode.UNSUPPORTED_STRENGTH, strength)

    category_prompt = CATEGORY_PROMPTS.get((composition, background_style), "")
    style_sheet = _short_style_sheet(background_style, composition)

    parts = [
        PRESERVATION_RULES,
        "The selected scene style must change only the environment, not the uploaded product.",
        category_prompt,
        style_sheet,
        STRENGTH_RULES[strength],
        QUALITY_RULES,
    ]

    return " ".join(x for x in parts if x)


def build_background_only_prompt(background_style: str, composition: str) -> str:
    return (
        "Create an empty professional product photography scene with no product. "
        + BACKGROUND_PROMPTS[background_style]
        + " "
        + COMPOSITION_PROMPTS[composition]
    )
